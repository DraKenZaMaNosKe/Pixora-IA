<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixora launch screen (Black & Gold).
  Shown by Android for the ~200 ms while Flutter process boots, before the
  Flutter splash renders. Kept minimal: solid black + centered gold diamond
  ornament so the transition to the Art Deco splash feels seamless.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launchBg" />

    <item
        android:gravity="center"
        android:drawable="@drawable/launch_logo" />
</layer-list>
